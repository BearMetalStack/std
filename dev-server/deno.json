{
	"name": "@bearmetal/dev-server",
	"version": "0.2.0",
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts"
	},
	"tasks": {
		"dev": "deno run -RWN -E=BEARMETAL_ENV,BMDEV_DENO --allow-run=deno --watch mod.ts test --entry=index.tsx",
		"install": "deno install -fg --name=bmdev --config=deno.json --allow-read --allow-write --allow-net --allow-env --allow-run mod.ts"
	},
	"license": "MIT",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@bearmetal/jsx"
	}
}
