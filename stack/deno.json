{
	"name": "@bearmetal/stack",
	"version": "0.0.8",
	"license": "GPL-3.0-only",
	"exports": {
		".": "./mod.tsx",
		"./create": "./create.ts",
		"./types": "./types.ts"
	},
	"tasks": {
		"dev": "deno test --watch",
		"bm:templates": {
			"description": "Regenerates the embedded scaffolding templates from the example apps",
			"command": "deno run -RW templates/generate.ts"
		}
	},
	"fmt": {
		"useTabs": true
	},
	"lint": {
		"rules": {
			"exclude": [
				"no-explicit-any"
			]
		}
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@bearmetal/jsx"
	}
}
