{
    "tasks": {
        "dev": "deno run -A --watch main.ts",
        "prod": "export BEARMETAL_ENV=prod && deno run -A --watch main.ts"
    },
    "imports": {
        "@app/": "app/",
        "@views/": "views/",
        "@bearmetal/jsx": "jsr:@bearmetal/jsx@^0.0.10"
    },
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "@bearmetal/jsx",
        "noImplicitOverride": false
    }
}
