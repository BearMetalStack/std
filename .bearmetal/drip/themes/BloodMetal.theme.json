				"--color-success-bg": "var(--color-bg_base-100)",
				"--btn-success-bg": "var(--color-success-600)",
				"--color-danger-text": "var(--color-error-700)",
				"--color-danger-bg": "var(--color-bg_base-200)",
				"--btn-danger-bg": "var(--color-error-600)",
				"--color-warning-text": "var(--color-warning-700)",
				"--color-warning-bg": "var(--color-gold-300)",
				"--btn-warning-bg": "var(--color-warning-500)",
				"--color-info-text": "var(--color-info-600)",
				"--color-info-bg": "var(--color-bg_base-100)",
				"--btn-info-bg": "var(--color-info-400)"
			}
		},
		{
			"name": "dark",
			"media": "(prefers-color-scheme: dark)",
			"rules": {
				"--color-bg": "var(--color-bg_base-700)",
				"--color-bg-subtle": "var(--color-bg_base-600)",
				"--color-bg-muted": "var(--color-bg_base-500)",
				"--color-bg-emphasis": "var(--color-bg_base-400)",
				"--color-surface": "var(--color-surface_dark-500)",
				"--color-surface-raised": "var(--color-surface_dark-600)",
				"--color-surface-overlay": "var(--color-surface_dark-700)",
				"--color-text": "var(--color-text_light)",
				"--color-text-subtle": "var(--color-text_muted)",
				"--color-text-muted": "var(--color-text_medium)",
				"--color-text-disabled": "var(--color-text_subtle)",
				"--color-border": "var(--color-border_color-400)",
				"--color-border-strong": "var(--color-bg_base-500)",
				"--color-border-subtle": "var(--color-bg_base-400)",
				"--color-interactive": "var(--color-primary-300)",
				"--color-interactive-hover": "var(--color-primary-200)",
				"--toast-bg": "var(--color-surface_dark-700)",
				"--toast-color": "var(--color-text_light)",
				"--toast-border": "var(--color-border_color-400)",
				"--color-success-text": "var(--color-success-300)",
				"--color-success-bg": "var(--color-bg_base-100)",
				"--btn-success-bg": "var(--color-success-300)",
				"--color-danger-text": "var(--color-error-300)",
				"--color-danger-bg": "var(--color-bg_base-200)",
				"--btn-danger-bg": "var(--color-error-300)",
				"--color-warning-text": "var(--color-warning-400)",
				"--color-warning-bg": "var(--color-gold-500)",
				"--btn-warning-bg": "var(--color-warning-600)",
				"--color-info-text": "var(--color-info-400)",
				"--color-info-bg": "var(--color-bg_base-200)",
				"--btn-info-bg": "var(--color-info-300)"
			}
		}
