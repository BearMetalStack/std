	"#variants": [
		{
			"name": "light",
			"default": true,
			"rules": {
				"--color-bg": "var(--color-bg_base-400)",
				"--color-bg-subtle": "var(--color-bg_base-300)",
				"--color-bg-muted": "var(--color-bg_base-200)",
