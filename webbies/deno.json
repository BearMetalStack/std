{
	"name": "@bearmetal/webbies",
	"version": "0.0.9",
	"license": "MIT",
	"tasks": {
		"test": "deno test -R",
		"dev": "deno -A --watch=components LinkMods.ts ./components & deno bundle --watch --platform=browser --sourcemap=inline public/index.html --outdir dist & deno run -NR --watch server.ts"
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@bearmetal/jsx"
	},
	"publish": {
		"exclude": [
			"./prod",
			"./dist"
		]
	},
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./style": "./style/mod.ts"
	},
	"imports": {
		"@lib/": "./lib/",
		"@/": "./",
		"@style": "./style/mod.ts",
		"@components": "./components/mod.ts"
	},
	"fmt": {
		"useTabs": true
	}
}
