{
	"name": "auth",
	"version": "0.1.0",
	"exports": "./mod.ts",
	"tasks": {
		"dev": "deno run -P=test --env-file --watch main.ts"
	},
	"permissions": {
		"test": {
			"env": [
				"PGUSER",
				"PGPASSWORD",
				"PGHOST",
				"PGPORT",
				"PGAPPNAME",
				"PGOPTIONS",
				"PGDATABASE",
				"BEARMETAL_PROXY_HOST",
				"BEARMETAL_ENV"
			],
			"net": ["dev.bear-metal.dev", "0.0.0.0:3000", "localhost:5432"]
		}
	},
	"license": "GPL-3.0-only",
	"imports": {
		"@bearmetal/db": "jsr:@bearmetal/db@^0.0.4",
		"@bearmetal/devproxy": "jsr:@bearmetal/devproxy@^0.0.2",
		"@bearmetal/jsx": "jsr:@bearmetal/jsx@^0.0.8",
		"@bearmetal/router": "jsr:@bearmetal/router@0.5.0-dev.5",
		"@std/assert": "jsr:@std/assert@^1.0.19"
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@bearmetal/jsx/server"
	}
}
