{
	"name": "@bearmetal/gutenbearg",
	"description": "Documentation sites for BearMetal: page templates, content blocks and the reading chrome around them",
	"version": "0.1.0",
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./templates": "./templates/mod.ts",
		"./blocks": "./blocks/mod.tsx",
		"./module": "./module.tsx",
		"./build": "./build.ts",
		"./cli": "./cli.ts"
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@bearmetal/jsx"
	},
	"tasks": {
		"dev": "deno test --watch -RW --allow-run=git",
		"test": "deno test -RW --allow-run=git",
		"example": "deno task --cwd=examples/bramble dev",
		"bm:icons": {
			"description": "Copies the Phosphor regular and fill sheets in from webbies",
			"command": "deno run -RW tools/icons.ts"
		}
	},
	"publish": {
		"exclude": [
			"tools",
			"examples"
		]
	},
	"license": "MIT"
}
