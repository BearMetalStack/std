{
	"name": "@bearmetal/router",
	"description": "A simple router for Deno",
	"version": "0.5.6",
	"license": "MIT",
	"stable": true,
	"tasks": {
		"test": {
			"command": "deno test -RW"
		},
		"check:browser": {
			"command": "deno bundle --platform=browser --outdir=/tmp/bearmetal-router-api-browser-check api/mod.ts"
		},
		"dirty": {
			"command": "deno publish --allow-dirty"
		},
		"dev": {
			"command": "deno run --allow-net --allow-read --allow-write --watch example.ts"
		}
	},
	"files": [
		"mod.ts",
		"api/",
		"modules/",
		"README.md"
	],
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./response": "./util/response.ts",
		"./api": "./api/mod.ts",
		"./api/server": "./api/server.ts",
		"./modules/forager": "./modules/forager.ts"
	},
	"exclude": [
		".vscode/",
		".zed/"
	],
	"imports": {
		"@/": "./"
	}
}
