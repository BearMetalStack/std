{
	"tasks": {
		"dev": "deno run --watch main.ts",
		"dependencies": "deno run -R dep_graph.ts",
		"workspace:publish": "deno run -P=publish --env-file publish_workspace.ts"
	},
	"permissions": {
		"publish": {
			"run": true,
			"read": true,
			"env": ["JSR_PUBLISH_TOKEN"]
		}
	},
	"workspace": ["./*"],
	"unstable": ["raw-imports", "bundle"],
	"imports": {
		"@std/assert": "jsr:@std/assert@1",
		"@std/fs": "jsr:@std/fs@^1.0.23",
		"@std/testing": "jsr:@std/testing@1"
	},
	"compilerOptions": {
		"lib": [
			"deno.window",
			"deno.unstable",
			"deno.ns",
			"deno.worker",
			"esnext",
			"dom",
			"dom.iterable",
			"dom.asynciterable"
		]
	}
}
