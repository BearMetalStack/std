{
    "tasks": {
        "workspace:map-dependencies": "deno run -R dep_graph.ts",
        "workspace:publish": {
            "command": "deno run -P=publish --env-file publish_workspace.ts",
            "description": "Publishes all packages in order of dependency",
            "dependencies": ["workspace:bump-versions"]
        },
        "workspace:bump-versions": {
            "command": "deno run -P=bump version_bump.ts",
            "description": "Bumps versions of packages that have had changes since last bump"
        },
        "workspace:manifest": {
            "description": "Lists all packages at their current version",
            "command": "deno run -R manifest.ts"
        },
        "bm:drip": {
            "description": "Generates theme completions and CSS",
            "command": "deno run -RW drip/mod.ts"
        },
        "play": {
            "description": "Runs the playground for the current dev",
            "command": "deno task --cwd=playground play"
        },
        "docs:dev": "dx -A vitepress dev docs",
        "docs:build": "dx -A vitepress build docs",
        "docs:preview": "dx -A vitepress preview docs"
    },
    "permissions": {
        "publish": {
            "run": true,
            "read": true,
            "env": ["JSR_PUBLISH_TOKEN"]
        },
        "bump": {
            "run": true,
            "read": true,
            "write": true
        },
        "docs": {
            "read": true,
            "write": true,
            "env": true,
            "ffi": true,
            "sys": true,
            "net": true
        }
    },
    "workspace": ["./*", "./*/examples/*"],
    "unstable": ["raw-imports", "bundle"],
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/fs": "jsr:@std/fs@1",
        "@std/testing": "jsr:@std/testing@1"
    },
    "fmt": {
        "useTabs": true,
        "lineWidth": 100
    },
    "compilerOptions": {
        "lib": [
            "deno.window",
            "deno.unstable",
            "deno.ns",
            "deno.worker",
            "esnext",
            "dom",
            "dom.iterable",
            "dom.asynciterable"
        ],
        "noImplicitOverride": false
    }
}
