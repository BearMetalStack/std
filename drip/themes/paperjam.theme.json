	"jam": {
		"spread": {
			"$ref": "$color.brand.500"
		},
		"smear": {
			"$ref": "$color.brand.700"
		}
	},
	"radius": {
		"base": "0__25rem"
	},
	"corner": {
		"shape": "round bevel round round",
		"pill": "round"
	},
	"shadow": {
		"xs": "-2px 3px 0 0 var(--jam-spread)",
		"sm": "-3px 4px 0 0 var(--jam-spread), -6px 8px 6px -2px var(--jam-smear)",
		"base": "-4px 5px 0 0 var(--jam-spread), -8px 10px 10px -2px var(--jam-smear)",
		"md": "-5px 6px 0 0 var(--jam-spread), -10px 12px 16px -3px var(--jam-smear)",
		"lg": "-6px 7px 0 0 var(--jam-spread), -12px 14px 24px -3px var(--jam-smear)",
		"xl": "-8px 9px 0 0 var(--jam-spread), -16px 18px 36px -4px var(--jam-smear)",
		"inner": "inset 3px 0 0 0 var(--jam-spread)",
		"focus": "0 0 0 2px var(--color-bg), 0 0 0 5px var(--color-border-focus)"
	},
	"state": {
		"selected": {
			"indicator": "inset 4px 0 0 0 var(--jam-spread)"
		},
		"pressed": {
			"translate": "-2px 3px"
		},
		"disabled": {
			"opacity": "0__65",
			"pattern": "repeating-linear-gradient(0deg, transparent 0 3px, var(--color-bg-emphasis) 3px 5px)"
		},
		"focus": {
			"width": "3px",
			"offset": "3px"
		},
		"invalid": {
			"border": {
				"style": "double",
				"width": "3px"
			}
		}
	},
	"btn": {
		"font": {
			"weight": {
				"$ref": "$weight.bold"
			}
		},
		"radius": {
			"xs": "0__15rem 0__5rem 0__15rem 0__15rem",
			"sm": "0__15rem 0__7rem 0__15rem 0__15rem",
			"base": "0__15rem 0__9rem 0__15rem 0__15rem",
			"lg": "0__15rem 1__4rem 0__15rem 0__15rem"
		},
		"padding": {
