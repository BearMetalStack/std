		"inner": "inset 0 1px 0 0 var(--color-border-strong)",
		"focus": "0 0 0 3px var(--color-highlight-bg), 0 0 0 4px var(--color-border-strong)"
	},
	"state": {
		"hover": {
			"decoration": "underline double"
		},
		"selected": {
			"bg": {
				"$ref": "$color.highlight.bg"
			},
			"color": {
				"$ref": "$color.highlight.text"
			},
			"indicator": "inset 0 -1px 0 0 currentColor, inset 0 -3px 0 0 var(--color-highlight-bg), inset 0 -4px 0 0 currentColor"
		},
		"pressed": {
			"translate": "2px 2px"
		},
		"disabled": {
			"opacity": "1",
			"pattern": "linear-gradient(transparent 22%, var(--color-text) 22% 78%, transparent 78%)"
		},
		"focus": {
			"width": "3px",
			"offset": "3px"
		},
		"invalid": {
			"border": {
				"style": "double",
				"width": "3px"
			}
		}
	},
