		"xs": "2px 2px 0 0 var(--form-canary), 2px 2px 0 1px var(--color-border-strong)",
		"sm": "3px 3px 0 0 var(--form-canary), 3px 3px 0 1px var(--color-border-strong), 6px 6px 0 0 var(--form-pink), 6px 6px 0 1px var(--color-border-strong)",
		"base": "4px 4px 0 0 var(--form-canary), 4px 4px 0 1px var(--color-border-strong), 8px 8px 0 0 var(--form-pink), 8px 8px 0 1px var(--color-border-strong)",
		"md": "4px 4px 0 0 var(--form-canary), 4px 4px 0 1px var(--color-border-strong), 8px 8px 0 0 var(--form-pink), 8px 8px 0 1px var(--color-border-strong), 0 18px 30px -10px rgb(0 0 0 / 0__35)",
		"lg": "5px 5px 0 0 var(--form-canary), 5px 5px 0 1px var(--color-border-strong), 10px 10px 0 0 var(--form-pink), 10px 10px 0 1px var(--color-border-strong), 0 26px 44px -12px rgb(0 0 0 / 0__35)",
