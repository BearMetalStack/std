			"$ref": "$color.brand.400"
		},
		"b": {
			"$ref": "$color.accent.400"
		}
	},
	"radius": {
		"base": "0__125rem"
	},
	"corner": {
		"shape": "square",
		"pill": "round"
	},
	"border": {
		"rule": {
			"$ref": "$border.2"
		}
	},
	"shadow": {
		"xs": "-2px 2px 0 0 var(--print-a), 2px -2px 0 0 var(--print-b)",
		"sm": "-3px 3px 0 0 var(--print-a), 3px -3px 0 0 var(--print-b)",
		"base": "-4px 4px 0 0 var(--print-a), 4px -4px 0 0 var(--print-b)",
		"md": "-5px 5px 0 0 var(--print-a), 5px -5px 0 0 var(--print-b), 0 14px 28px -10px rgb(0 0 0 / 0__35)",
		"lg": "-6px 6px 0 0 var(--print-a), 6px -6px 0 0 var(--print-b), 0 22px 44px -12px rgb(0 0 0 / 0__35)",
		"xl": "-8px 8px 0 0 var(--print-a), 8px -8px 0 0 var(--print-b), 0 32px 64px -14px rgb(0 0 0 / 0__4)",
		"inner": "inset 2px 2px 0 0 var(--print-a)",
		"focus": "-3px 3px 0 0 var(--print-a), 3px -3px 0 0 var(--print-b)"
	},
	"state": {
		"hover": {
			"decoration": "underline double"
		},
		"selected": {
			"indicator": "inset 0 -3px 0 0 var(--print-b)"
		},
		"pressed": {
			"translate": "-2px 2px"
		},
		"disabled": {
			"opacity": "0__6",
			"pattern": "repeating-linear-gradient(45deg, transparent 0 3px, var(--color-bg-emphasis) 3px 4px)"
		},
		"focus": {
			"width": "3px",
			"offset": "4px"
		}
	},
	"btn": {
		"letter": {
			"spacing": {
				"$ref": "$tracking.widest"
			}
		},
		"font": {
			"weight": {
				"$ref": "$weight.bold"
			}
		},
		"padding": {
			"x": {
				"xs": {
					"$ref": "$space.3"
				},
				"sm": {
					"$ref": "$space.4"
				},
				"base": {
					"$ref": "$space.5"
				}
			}
