		"hover": {
			"decoration": "underline dotted"
		},
		"selected": {
			"indicator": "inset 0 0 0 2px currentColor"
		},
		"disabled": {
			"border": {
				"style": "dashed"
			}
		},
		"focus": {
			"width": "3px",
			"style": "dotted",
			"offset": "3px"
		}
