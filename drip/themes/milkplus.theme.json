	"milk": {
		"lip": {
			"$ref": "$color.neutral.300"
		},
		"pour": {
			"$ref": "$color.brand.800"
		}
	},
	"radius": {
		"base": "0__75rem"
	},
	"border": {
		"rule": {
			"$ref": "$border.2"
		}
	},
	"shadow": {
		"xs": "inset 0 2px 0 0 rgb(255 255 255 / 0__35), 0 3px 0 0 var(--milk-lip)",
		"sm": "0 4px 0 0 var(--milk-lip)",
		"base": "0 5px 0 0 var(--milk-lip), 0 12px 18px -6px rgb(0 0 0 / 0__18)",
		"md": "0 6px 0 0 var(--milk-lip), 0 18px 28px -8px rgb(0 0 0 / 0__18)",
		"lg": "0 8px 0 0 var(--milk-lip), 0 26px 40px -10px rgb(0 0 0 / 0__18)",
		"xl": "0 10px 0 0 var(--milk-lip), 0 36px 60px -12px rgb(0 0 0 / 0__18)",
		"inner": "inset 0 3px 0 0 var(--milk-lip)",
		"focus": "0 0 0 4px rgb(from var(--color-border-focus) r g b / 0__45)"
	},
	"state": {
		"selected": {
			"indicator": "inset 0 -3px 0 0 currentColor"
		},
		"pressed": {
			"translate": "0 3px"
		},
		"disabled": {
			"border": {
				"style": "dotted"
			}
		},
		"focus": {
			"width": "3px",
			"offset": "3px"
		}
	},
	"btn": {
		"font": {
			"weight": {
				"$ref": "$weight.bold"
			}
		},
		"primary": {
			"shadow": "inset 0 2px 0 0 rgb(255 255 255 / 0__35), 0 4px 0 0 var(--milk-pour)"
		},
