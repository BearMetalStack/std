{
	"font": {
		"sans": "\"Urbanist\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif, \"Apple Color Emoji\"",
		"serif": "\"Georgia\", \"Times New Roman\", Times, serif",
		"mono": "\"JetBrains Mono\", \"Fira Code\", \"Cascadia Code\", ui-monospace, \"Courier New\", monospace",
		"display": { "$ref": "$font.sans" },
		"body": { "$ref": "$font.sans" }
	},
	"text": {
		"xs": "0__64rem",
		"sm": "0__8rem",
		"base": "1rem",
		"md": "1__25rem",
		"lg": "1__563rem",
		"xl": "1__953rem",
		"2xl": "2__441rem",
		"3xl": "3__052rem",
		"4xl": "3__815rem"
	},
	"leading": {
		"none": "1",
		"tight": "1__25",
		"snug": "1__375",
		"normal": "1__5",
		"relaxed": "1__625",
		"loose": "2"
	},
	"weight": {
		"thin": "100",
		"light": "300",
		"normal": "400",
		"medium": "500",
		"semibold": "600",
		"bold": "700",
		"extrabold": "800",
		"black": "900"
	},
	"tracking": {
		"tighter": "-0__05em",
		"tight": "-0__025em",
		"normal": "0",
		"wide": "0__025em",
		"wider": "0__05em",
		"widest": "0__1em"
	},
	"space": {
		"0": {
			"5": { "$calc": { "op": "*", "left": "$space.unit", "right": 0.5 } },
			"": "0"
		},
		"1": {
			"5": { "$calc": { "op": "*", "left": "$space.unit", "right": 1.5 } },
			"$calc": { "op": "*", "left": "$space.unit", "right": 1 }
		},
		"2": {
			"5": { "$calc": { "op": "*", "left": "$space.unit", "right": 2.5 } },
			"$calc": { "op": "*", "left": "$space.unit", "right": 2 }
		},
		"3": { "$calc": { "op": "*", "left": "$space.unit", "right": 3 } },
		"4": { "$calc": { "op": "*", "left": "$space.unit", "right": 4 } },
		"5": { "$calc": { "op": "*", "left": "$space.unit", "right": 5 } },
		"6": { "$calc": { "op": "*", "left": "$space.unit", "right": 6 } },
		"7": { "$calc": { "op": "*", "left": "$space.unit", "right": 7 } },
		"8": { "$calc": { "op": "*", "left": "$space.unit", "right": 8 } },
		"10": { "$calc": { "op": "*", "left": "$space.unit", "right": 10 } },
		"12": { "$calc": { "op": "*", "left": "$space.unit", "right": 12 } },
		"14": { "$calc": { "op": "*", "left": "$space.unit", "right": 14 } },
		"16": { "$calc": { "op": "*", "left": "$space.unit", "right": 16 } },
		"20": { "$calc": { "op": "*", "left": "$space.unit", "right": 20 } },
		"24": { "$calc": { "op": "*", "left": "$space.unit", "right": 24 } },
		"32": { "$calc": { "op": "*", "left": "$space.unit", "right": 32 } },
		"40": { "$calc": { "op": "*", "left": "$space.unit", "right": 40 } },
		"48": { "$calc": { "op": "*", "left": "$space.unit", "right": 48 } },
		"64": { "$calc": { "op": "*", "left": "$space.unit", "right": 64 } },
		"unit": "0__25rem",
		"px": "1px"
	},
	"radius": {
		"none": "0",
		"sm": { "$calc": { "op": "*", "left": "$radius.base", "right": 0.5 } },
		"base": "0__25rem",
		"md": { "$calc": { "op": "*", "left": "$radius.base", "right": 1.5 } },
		"lg": { "$calc": { "op": "*", "left": "$radius.base", "right": 2 } },
		"xl": { "$calc": { "op": "*", "left": "$radius.base", "right": 3 } },
		"2xl": { "$calc": { "op": "*", "left": "$radius.base", "right": 4 } },
		"3xl": { "$calc": { "op": "*", "left": "$radius.base", "right": 6 } },
		"full": "9999px"
	},
	"border": {
		"0": "0",
		"1": { "5": "1__5px", "": "1px" },
		"2": "2px",
		"4": "4px",
		"8": "8px"
	},
	"shadow": {
		"none": "none",
		"xs": "0 1px 2px 0 rgb(0 0 0 / 0__05)",
		"sm": "0 1px 3px 0 rgb(0 0 0 / 0__1), 0 1px 2px -1px rgb(0 0 0 / 0__1)",
		"base": "0 4px 6px -1px rgb(0 0 0 / 0__1), 0 2px 4px -2px rgb(0 0 0 / 0__1)",
		"md": "0 10px 15px -3px rgb(0 0 0 / 0__1), 0 4px 6px -4px rgb(0 0 0 / 0__1)",
		"lg": "0 20px 25px -5px rgb(0 0 0 / 0__1), 0 8px 10px -6px rgb(0 0 0 / 0__1)",
		"xl": "0 25px 50px -12px rgb(0 0 0 / 0__25)",
		"inner": "inset 0 2px 4px 0 rgb(0 0 0 / 0__05)",
		"focus": "0 0 0 3px rgb(from var(--color-border-focus) r g b / 0__35)"
	},
	"z": {
		"hide": "-1",
		"base": "0",
		"raised": "10",
		"dropdown": "100",
		"sticky": "200",
		"overlay": "300",
		"modal": "400",
		"popover": "500",
		"toast": "600",
		"tooltip": "700",
		"top": "9999"
	},
	"duration": {
		"instant": "0ms",
		"fast": "80ms",
		"base": "150ms",
		"slow": "300ms",
		"slower": "500ms",
		"lazy": "700ms"
	},
	"ease": {
		"linear": "linear",
		"in": { "": "cubic-bezier(0__4, 0, 1, 1)", "out": "cubic-bezier(0__4, 0, 0__2, 1)" },
		"out": "cubic-bezier(0, 0, 0__2, 1)",
		"spring": "cubic-bezier(0__34, 1__56, 0__64, 1)",
		"bounce": "cubic-bezier(0__68, -0__55, 0__265, 1__55)"
	},
	"transition": {
		"colors": "color var(--duration-base) var(--ease-in-out), background-color var(--duration-base) var(--ease-in-out), border-color var(--duration-base) var(--ease-in-out), text-decoration-color var(--duration-base) var(--ease-in-out), fill var(--duration-base) var(--ease-in-out), stroke var(--duration-base) var(--ease-in-out)",
		"opacity": "opacity var(--duration-base) var(--ease-in-out)",
		"shadow": "box-shadow var(--duration-base) var(--ease-in-out)",
		"transform": "transform var(--duration-base) var(--ease-in-out)",
		"all": "all var(--duration-base) var(--ease-in-out)"
	},
	"bp": {
		"xs": "480px",
		"sm": "640px",
		"md": "768px",
		"lg": "1024px",
		"xl": "1280px",
		"2xl": "1536px"
	},
	"container": {
		"xs": "480px",
		"sm": "640px",
		"md": "768px",
		"lg": "1024px",
		"xl": "1280px",
		"2xl": "1536px",
		"prose": "65ch"
	},
	"grid": {
		"cols": "12",
		"gap": { "$ref": "$space.6" }
	},
	"btn": {
		"font": {
			"family": { "$ref": "$font.body" },
			"weight": { "$ref": "$weight.semibold" },
			"size": {
				"xs": { "$ref": "$text.xs" },
				"sm": { "$ref": "$text.sm" },
				"base": { "$ref": "$text.base" },
				"lg": { "$ref": "$text.md" }
			}
		},
		"letter": { "spacing": { "$ref": "$tracking.wide" } },
		"border": { "width": { "$ref": "$border.2" } },
		"transition": { "$ref": "$transition.colors" },
		"padding": {
			"y": {
				"xs": { "$ref": "$space.1" },
				"sm": { "$ref": "$space.1.5" },
				"base": { "$ref": "$space.2" },
				"lg": { "$ref": "$space.3" }
			},
			"x": {
				"xs": { "$ref": "$space.2" },
				"sm": { "$ref": "$space.3" },
				"base": { "$ref": "$space.4" },
				"lg": { "$ref": "$space.6" }
			}
		},
		"radius": {
			"xs": { "$ref": "$radius.base" },
			"sm": { "$ref": "$radius.md" },
			"base": { "$ref": "$radius.md" },
			"lg": { "$ref": "$radius.lg" }
		},
		"active": { "border": { "$ref": "$color.border.strong" } },
		"primary": {
			"bg": {
				"$ref": "$color.interactive",
				"hover": { "$ref": "$color.interactive.hover" },
				"active": { "$ref": "$color.interactive.active" }
			},
			"color": { "$ref": "$color.text.on.brand" },
			"border": "transparent",
			"shadow": { "$ref": "$shadow.xs" }
		},
		"secondary": {
			"bg": { "$ref": "$color.surface", "hover": { "$ref": "$color.bg.muted" } },
			"color": { "$ref": "$color.text" },
			"border": { "$ref": "$color.border.strong" },
			"shadow": { "$ref": "$shadow.xs" }
		},
		"ghost": {
			"bg": { "": "transparent", "hover": { "$ref": "$color.bg.muted" } },
			"color": { "$ref": "$color.text.subtle" },
			"border": "transparent",
			"shadow": "none"
		}
	},
	"input": {
		"font": {
			"family": { "$ref": "$font.body" },
			"size": {
				"$ref": "$text.base",
				"sm": { "$ref": "$text.sm" },
				"lg": { "$ref": "$text.md" }
			}
		},
		"bg": { "$ref": "$color.surface", "disabled": { "$ref": "$color.bg.muted" } },
		"color": {
			"$ref": "$color.text",
			"placeholder": { "$ref": "$color.text.muted" }
		},
		"border": {
			"$ref": "$color.border.strong",
			"hover": { "$ref": "$color.interactive" },
			"focus": { "$ref": "$color.border.focus" },
			"error": { "$ref": "$color.danger.text" },
			"width": { "$ref": "$border.1" }
		},
		"radius": { "$ref": "$radius.md" },
		"padding": { "y": { "$ref": "$space.2" }, "x": { "$ref": "$space.3" } },
		"shadow": { "$ref": "$shadow.xs", "focus": { "$ref": "$shadow.focus" } },
		"transition": { "$ref": "$transition.colors" }
	},
	"card": {
		"bg": { "$ref": "$color.surface" },
		"border": { "$ref": "$color.border", "width": { "$ref": "$border.1" } },
		"radius": { "$ref": "$radius.base" },
		"shadow": { "$ref": "$shadow.sm" },
		"padding": {
			"$ref": "$space.6",
			"sm": { "$ref": "$space.4" },
			"lg": { "$ref": "$space.8" }
		}
	},
	"badge": {
		"font": {
			"size": { "$ref": "$text.xs" },
			"weight": { "$ref": "$weight.semibold" }
		},
		"bg": { "$ref": "$color.bg.muted" },
		"color": { "$ref": "$color.text.subtle" },
		"border": { "$ref": "$color.border" },
		"padding": { "y": { "$ref": "$space.0.5" }, "x": { "$ref": "$space.2" } },
		"radius": { "$ref": "$radius.full" },
		"letter": { "spacing": { "$ref": "$tracking.wide" } }
	},
	"modal": {
		"bg": { "$ref": "$color.surface.overlay" },
		"border": { "$ref": "$color.border" },
		"radius": { "$ref": "$radius.2xl" },
		"shadow": { "$ref": "$shadow.xl" },
		"padding": { "$ref": "$space.8" },
		"max": {
			"width": { "sm": "24rem", "base": "32rem", "lg": "48rem", "xl": "64rem" }
		}
	},
	"toast": {
		"border": { "radius": { "$ref": "$radius.lg" } },
		"shadow": { "$ref": "$shadow.lg" },
		"padding": { "y": { "$ref": "$space.3" }, "x": { "$ref": "$space.4" } },
		"font": { "size": { "$ref": "$text.sm" } },
		"max": { "width": "24rem" }
	},
	"tooltip": {
		"font": { "size": { "$ref": "$text.xs" } },
		"padding": { "y": { "$ref": "$space.1" }, "x": { "$ref": "$space.2" } },
		"radius": { "$ref": "$radius.base" },
		"shadow": { "$ref": "$shadow.md" },
		"max": { "width": "16rem" }
	},
	"table": {
		"bg": "transparent",
		"header": {
			"bg": { "$ref": "$color.bg.subtle" },
			"font": { "weight": { "$ref": "$weight.semibold" } },
			"color": { "$ref": "$color.text.subtle" }
		},
		"row": {
			"bg": {
				"alt": { "$ref": "$color.bg.subtle" },
				"hover": { "$ref": "$color.bg.muted" }
			}
		},
		"border": { "$ref": "$color.border" },
		"cell": { "padding": { "y": { "$ref": "$space.3" }, "x": { "$ref": "$space.4" } } },
		"font": { "size": { "$ref": "$text.sm" } }
	},
	"nav": {
		"bg": { "$ref": "$color.surface" },
		"border": { "$ref": "$color.border" },
		"height": { "$ref": "$space.16" },
		"shadow": { "$ref": "$shadow.xs" },
		"item": {
			"color": {
				"$ref": "$color.text.subtle",
				"hover": { "$ref": "$color.text" },
				"active": { "$ref": "$color.interactive" }
			},
			"bg": { "hover": { "$ref": "$color.bg.muted" } },
			"font": {
				"weight": { "$ref": "$weight.medium" },
				"size": { "$ref": "$text.sm" }
			},
			"radius": { "$ref": "$radius.md" },
			"padding": { "y": { "$ref": "$space.2" }, "x": { "$ref": "$space.3" } }
		}
	},
	"sidebar": {
		"bg": { "$ref": "$color.bg.subtle" },
		"border": { "$ref": "$color.border" },
		"width": { "": "16rem", "collapsed": "4rem" },
		"padding": { "$ref": "$space.4" }
	},
	"avatar": {
		"size": {
			"xs": { "$ref": "$space.6" },
			"sm": { "$ref": "$space.8" },
			"base": { "$ref": "$space.10" },
			"lg": { "$ref": "$space.14" },
			"xl": { "$ref": "$space.16" }
		},
		"radius": { "$ref": "$radius.full" },
		"border": { "$ref": "$color.surface", "width": "2px" },
		"bg": { "$ref": "$color.interactive.subtle" },
		"color": { "$ref": "$color.text" },
		"font": { "weight": { "$ref": "$weight.semibold" } }
	},
	"progress": {
		"bg": { "$ref": "$color.bg.emphasis" },
		"fill": { "$ref": "$color.interactive" },
		"height": { "$ref": "$space.2" },
		"radius": { "$ref": "$radius.full" }
	},
	"spinner": {
		"color": { "$ref": "$color.interactive" },
		"track": { "color": { "$ref": "$color.bg.emphasis" } },
		"size": {
			"sm": { "$ref": "$space.4" },
			"base": { "$ref": "$space.6" },
			"lg": { "$ref": "$space.8" },
			"xl": { "$ref": "$space.10" }
		},
		"thickness": "2px"
	},
	"skeleton": {
		"bg": { "$ref": "$color.bg.emphasis" },
		"shine": { "$ref": "$color.bg.muted" },
		"radius": { "$ref": "$radius.base" },
		"duration": "1__5s"
	},
	"alert": {
		"padding": { "y": { "$ref": "$space.3" }, "x": { "$ref": "$space.4" } },
		"radius": { "$ref": "$radius.lg" },
		"border": { "width": { "$ref": "$border.1" } },
		"font": { "size": { "$ref": "$text.sm" } },
		"info": {
			"bg": { "$ref": "$color.info.bg" },
			"border": { "$ref": "$color.info.border" },
			"color": { "$ref": "$color.info.text" }
		},
		"success": {
			"bg": { "$ref": "$color.success.bg" },
			"border": { "$ref": "$color.success.border" },
			"color": { "$ref": "$color.success.text" }
		},
		"warning": {
			"bg": { "$ref": "$color.warning.bg" },
			"border": { "$ref": "$color.warning.border" },
			"color": { "$ref": "$color.warning.text" }
		},
		"danger": {
			"bg": { "$ref": "$color.danger.bg" },
			"border": { "$ref": "$color.danger.border" },
			"color": { "$ref": "$color.danger.text" }
		}
	},
	"divider": {
		"color": { "$ref": "$color.border" },
		"width": { "$ref": "$border.1" }
	},
	"tab": {
		"bar": { "border": { "$ref": "$color.border" } },
		"item": {
			"color": {
				"$ref": "$color.text.subtle",
				"hover": { "$ref": "$color.text" },
				"active": { "$ref": "$color.interactive" }
			},
			"font": {
				"weight": { "$ref": "$weight.medium" },
				"size": { "$ref": "$text.sm" }
			}
		},
		"indicator": { "color": { "$ref": "$color.interactive" }, "height": "2px" },
		"padding": { "y": { "$ref": "$space.3" }, "x": { "$ref": "$space.4" } }
	},
	"toggle": {
		"bg": {
			"off": { "$ref": "$color.bg.emphasis" },
			"on": { "$ref": "$color.interactive" }
		},
		"thumb": {
			"bg": { "$ref": "$color.surface" },
			"shadow": { "$ref": "$shadow.sm" },
			"size": "1__25rem"
		},
		"width": "2__75rem",
		"height": "1__5rem",
		"radius": { "$ref": "$radius.full" },
		"transition": { "$ref": "$transition.colors" }
	},
	"check": {
		"size": "1rem",
		"border": {
			"$ref": "$color.border.strong",
			"hover": { "$ref": "$color.interactive" },
			"checked": { "$ref": "$color.interactive" }
		},
		"bg": { "$ref": "$color.surface", "checked": { "$ref": "$color.interactive" } },
		"color": { "$ref": "$color.text.on.brand" },
		"radius": { "$ref": "$radius.base" },
		"transition": { "$ref": "$transition.colors" }
	},
	"radio": { "radius": { "$ref": "$radius.full" } },
	"dropdown": {
		"bg": { "$ref": "$color.surface.overlay" },
		"border": { "$ref": "$color.border" },
		"radius": { "$ref": "$radius.lg" },
		"shadow": { "$ref": "$shadow.md" },
		"padding": { "y": { "$ref": "$space.1" } },
		"item": {
			"padding": { "y": { "$ref": "$space.2" }, "x": { "$ref": "$space.3" } },
			"font": { "size": { "$ref": "$text.sm" } },
			"color": {
				"$ref": "$color.text",
				"hover": { "$ref": "$color.text" },
				"active": { "$ref": "$color.interactive" }
			},
			"bg": {
				"hover": { "$ref": "$color.bg.muted" },
				"active": { "$ref": "$color.interactive.subtle" }
			}
		}
	},
	"breadcrumb": {
		"font": { "size": { "$ref": "$text.sm" } },
		"color": { "$ref": "$color.text.subtle", "active": { "$ref": "$color.text" } },
		"separator": { "color": { "$ref": "$color.text.muted" } }
	},
	"pagination": {
		"item": {
			"size": { "$ref": "$space.8" },
			"radius": { "$ref": "$radius.md" },
			"bg": {
				"": "transparent",
				"hover": { "$ref": "$color.bg.muted" },
				"active": { "$ref": "$color.interactive" }
			},
			"color": {
				"$ref": "$color.text.subtle",
				"hover": { "$ref": "$color.text" },
				"active": { "$ref": "$color.text.on.brand" }
			},
			"font": {
				"size": { "$ref": "$text.sm" },
				"weight": { "$ref": "$weight.medium" }
			}
		}
	},
	"field": {
		"label": {
			"font": {
				"size": { "$ref": "$text.sm" },
				"weight": { "$ref": "$weight.medium" }
			},
			"color": { "$ref": "$color.text" },
			"gap": { "$ref": "$space.1.5" }
		},
		"hint": {
			"font": { "size": { "$ref": "$text.xs" } },
			"color": { "$ref": "$color.text.subtle" }
		},
		"error": {
			"font": { "size": { "$ref": "$text.xs" } },
			"color": { "$ref": "$color.danger.text" }
		},
		"gap": { "$ref": "$space.4" }
	},
	"empty": {
		"icon": { "color": { "$ref": "$color.text.muted" } },
		"title": { "color": { "$ref": "$color.text" } },
		"body": { "color": { "$ref": "$color.text.subtle" } },
		"padding": { "$ref": "$space.12" }
	}
}
