			"lg": "1__5",
			"xl": "2",
			"2xl": "2",
			"3xl": "3"
		}
	},
	"corner": {
		"shape": "bevel",
		"pill": "round"
	},
	"shadow": {
		"xs": "none",
		"sm": "none",
		"base": "none",
		"md": "3px 3px 0 0 var(--color-border-strong)",
		"lg": "4px 4px 0 0 var(--color-border-strong)",
		"xl": "6px 6px 0 0 var(--color-border-strong)",
		"inner": "none",
		"focus": "0 0 0 1px var(--color-border-focus)"
	},
	"duration": {
		"instant": "0ms",
		"fast": "0ms",
		"base": "0ms",
		"slow": "0ms",
		"slower": "0ms",
		"lazy": "0ms"
	},
	"motion": {
		"scroll": "auto"
	},
	"state": {
		"hover": {
			"decoration": "underline"
		},
		"selected": {
			"bg": {
				"$ref": "$color.surface"
			},
			"weight": {
				"$ref": "$weight.bold"
			},
			"indicator": "inset 0 -2px 0 0 currentColor"
		},
		"pressed": {
			"indicator": "inset 0 0 0 2px currentColor",
			"overlay": "transparent",
			"translate": "1px 1px"
		},
		"disabled": {
			"opacity": "0__6",
			"pattern": "repeating-linear-gradient(135deg, transparent 0 4px, var(--color-bg-emphasis) 4px 6px)",
			"border": {
				"style": "dashed"
			}
		},
		"focus": {
			"width": "3px"
		},
		"invalid": {
			"border": {
				"style": "double",
				"width": "3px"
			}
		}
	},
	"spinner": {
		"duration": "1__6s"
	},
	"skeleton": {
		"animation": "none",
		"shine": {
			"$ref": "$skeleton.bg"
		}
	},
	"alert": {
		"border": {
			"width": "3px"
		},
		"danger": {
			"border": {
				"style": "double"
			}
		},
		"warning": {
			"border": {
				"style": "dashed"
			}
		},
		"info": {
			"border": {
				"style": "dotted"
			}
		},
		"success": {
			"border": {
				"style": "solid"
			}
		}
	},
	"toast": {
		"border": {
			"width": "3px"
		}
	},
	"nav": {
		"shadow": "none",
		"item": {
			"decoration": {
				"active": "none"
			}
		}
	},
	"sidebar": {
		"bg": {
			"$ref": "$color.surface"
		},
		"item": {
			"bg": {
				"active": {
					"$ref": "$color.surface"
				}
			},
			"indicator": {
				"active": "inset 3px 0 0 0 currentColor"
			}
		}
	},
	"tab": {
		"indicator": {
			"height": "3px"
		},
		"item": {
			"weight": {
				"active": {
					"$ref": "$weight.bold"
				}
			}
		}
	},
	"table": {
		"header": {
			"bg": {
				"$ref": "$color.surface"
			}
		},
		"row": {
			"bg": {
				"alt": {
					"$ref": "$color.surface"
				}
			}
		}
	},
	"dropdown": {
		"item": {
			"indicator": {
				"active": "inset 3px 0 0 0 currentColor"
			}
		}
	},
	"btn": {
		"disabled": {
			"bg": {
				"$ref": "$color.surface"
			},
			"color": {
				"$ref": "$color.text.disabled"
			},
			"border": {
				"$ref": "$color.border.strong"
			}
		}
	},
