		"letter": {
			"spacing": {
				"$ref": "$tracking.widest"
			}
		},
		"radius": {
			"xs": "0__5rem 0__5rem 0__1rem 0__1rem",
			"sm": "0__8rem 0__8rem 0__125rem 0__125rem",
			"base": "1__1rem 1__1rem 0__15rem 0__15rem",
			"lg": "1__75rem 1__75rem 0__2rem 0__2rem"
		},
		"padding": {
			"x": {
