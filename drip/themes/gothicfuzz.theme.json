	"fuzz": {
		"near": {
			"$ref": "$color.brand.300"
		},
		"far": {
			"$ref": "$color.brand.500"
		}
	},
	"font": {
		"display": {
			"$ref": "$font.serif"
		}
	},
	"radius": {
		"base": "0__25rem"
	},
	"shadow": {
		"xs": "0 0 3px 2px var(--fuzz-near), 0 0 9px 3px var(--fuzz-far)",
		"sm": "0 0 4px 2px var(--fuzz-near), 0 0 12px 4px var(--fuzz-far)",
		"base": "0 0 6px 3px var(--fuzz-near), 0 0 18px 6px var(--fuzz-far)",
		"md": "0 0 8px 4px var(--fuzz-near), 0 0 24px 8px var(--fuzz-far), 0 16px 32px -8px rgb(0 0 0 / 0__4)",
		"lg": "0 0 10px 5px var(--fuzz-near), 0 0 30px 10px var(--fuzz-far), 0 24px 48px -10px rgb(0 0 0 / 0__45)",
		"xl": "0 0 14px 7px var(--fuzz-near), 0 0 42px 14px var(--fuzz-far), 0 36px 72px -12px rgb(0 0 0 / 0__5)",
		"inner": "inset 0 0 8px 0 var(--fuzz-near)",
		"focus": "0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-border-focus), 0 0 14px 5px var(--color-border-focus)"
	},
	"state": {
		"selected": {
			"indicator": "inset 0 0 10px 0 var(--fuzz-near)"
		},
		"disabled": {
			"opacity": "0__45",
			"border": {
				"style": "dashed"
			}
		},
		"focus": {
			"width": "2px",
			"offset": "3px"
		}
	},
	"spinner": {
		"duration": "1__4s"
	},
