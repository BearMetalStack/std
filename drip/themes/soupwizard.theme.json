	"radius": {
		"base": "0__25rem"
	},
	"corner": {
		"shape": "round"
	},
	"shadow": {
		"xs": "inset 0 2px 0 0 var(--soup-broth), 0 -3px 6px -2px var(--soup-steam), 0 -9px 12px -6px var(--soup-steam), 0 2px 0 0 var(--color-border-strong)",
		"sm": "inset 0 3px 0 0 var(--soup-broth), 0 -5px 10px -3px var(--soup-steam), 0 -15px 20px -10px var(--soup-steam), 0 2px 0 0 var(--color-border-strong)",
		"base": "inset 0 4px 0 0 var(--soup-broth), 0 -7px 14px -4px var(--soup-steam), 0 -21px 28px -14px var(--soup-steam), 0 2px 0 0 var(--color-border-strong)",
		"md": "inset 0 4px 0 0 var(--soup-broth), 0 -9px 18px -5px var(--soup-steam), 0 -27px 36px -18px var(--soup-steam), 0 2px 0 0 var(--color-border-strong)",
		"lg": "inset 0 5px 0 0 var(--soup-broth), 0 -12px 24px -6px var(--soup-steam), 0 -36px 48px -24px var(--soup-steam), 0 2px 0 0 var(--color-border-strong)",
		"xl": "inset 0 6px 0 0 var(--soup-broth), 0 -16px 32px -8px var(--soup-steam), 0 -48px 64px -32px var(--soup-steam), 0 2px 0 0 var(--color-border-strong)",
		"inner": "inset 0 3px 0 0 var(--soup-broth)",
		"focus": "0 0 0 2px var(--color-bg), 0 0 0 5px var(--color-border-focus)"
	},
	"state": {
		"hover": {
			"decoration": "underline dotted"
		},
		"selected": {
			"indicator": "inset 0 -3px 0 0 var(--soup-broth)"
		},
		"pressed": {
			"translate": "0 2px"
		},
		"disabled": {
			"border": {
				"style": "dashed"
			}
		},
		"focus": {
			"width": "3px",
			"style": "dotted",
			"offset": "3px"
		}
	},
	"spinner": {
		"duration": "1__2s"
	},
	"btn": {
		"font": {
