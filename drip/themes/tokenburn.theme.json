	"burn": {
		"core": {
			"$ref": "$color.accent.300"
		},
		"flame": {
			"$ref": "$color.brand.400"
		},
		"ember": {
			"$ref": "$color.red.600"
		}
	},
	"font": {
		"display": {
			"$ref": "$font.mono"
		},
		"body": {
			"$ref": "$font.mono"
		}
	},
	"radius": {
		"base": "0__375rem"
	},
	"corner": {
		"shape": "notch",
		"pill": "bevel"
	},
	"shadow": {
		"xs": "0 1px 0 0 var(--burn-core), 0 3px 6px -1px var(--burn-flame)",
		"sm": "0 1px 0 0 var(--burn-core), 0 4px 8px -1px var(--burn-flame), 0 10px 18px -5px var(--burn-ember)",
		"base": "0 2px 0 0 var(--burn-core), 0 5px 10px -1px var(--burn-flame), 0 14px 26px -7px var(--burn-ember)",
		"md": "0 2px 0 0 var(--burn-core), 0 6px 12px -1px var(--burn-flame), 0 20px 36px -10px var(--burn-ember)",
		"lg": "0 2px 0 0 var(--burn-core), 0 8px 16px -1px var(--burn-flame), 0 28px 52px -14px var(--burn-ember)",
		"xl": "0 3px 0 0 var(--burn-core), 0 10px 20px -1px var(--burn-flame), 0 40px 72px -20px var(--burn-ember)",
		"focus": "0 0 0 2px var(--color-bg), 0 0 0 4px var(--color-border-focus)"
	},
	"state": {
		"hover": {
			"decoration": "underline"
		},
		"selected": {
			"indicator": "inset 0 -2px 0 0 var(--burn-flame)"
		},
		"pressed": {
			"translate": "0 1px"
		},
		"disabled": {
			"opacity": "0__6",
			"pattern": "repeating-linear-gradient(135deg, transparent 0 4px, var(--color-bg-emphasis) 4px 6px)",
			"border": {
				"style": "dashed"
			}
		},
		"focus": {
			"width": "2px",
			"style": "dashed",
			"offset": "3px"
		}
	},
	"spinner": {
		"duration": "0__4s"
	},
	"btn": {
		"letter": {
			"spacing": {
				"$ref": "$tracking.wider"
			}
		},
		"padding": {
			"x": {
				"xs": {
					"$ref": "$space.3"
				},
				"sm": {
					"$ref": "$space.4"
				},
				"base": {
					"$ref": "$space.5"
				}
			}
		}
	},
	"badge": {
		"padding": {
			"x": {
				"$ref": "$space.3"
			}
		}
	},
	"tag": {
		"padding": {
			"x": {
				"$ref": "$space.3"
			}
		},
		"border": {
			"style": "dashed"
		}
	},
	"nav": {
		"item": {
			"padding": {
				"x": {
					"$ref": "$space.4"
				}
			}
		}
	},
	"dropdown": {
		"item": {
			"padding": {
				"x": {
					"$ref": "$space.4"
				}
			}
		}
	},
