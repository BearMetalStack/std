		}
	},
	"radius": {
		"base": "0__3rem"
	},
	"corner": {
		"shape": "bevel",
		"pill": "round"
	},
	"shadow": {
		"xs": "0 0 0 1px var(--brass-edge), 0 0 0 3px var(--brass-face), 0 0 0 4px var(--brass-edge)",
		"sm": "0 0 0 1px var(--brass-edge), 0 0 0 4px var(--brass-face), 0 0 0 5px var(--brass-edge)",
		"base": "0 0 0 1px var(--brass-edge), 0 0 0 5px var(--brass-face), 0 0 0 6px var(--brass-edge)",
		"md": "0 0 0 1px var(--brass-edge), 0 0 0 6px var(--brass-face), 0 0 0 7px var(--brass-edge), 0 16px 28px -6px rgb(0 0 0 / 0__4)",
		"lg": "0 0 0 1px var(--brass-edge), 0 0 0 7px var(--brass-face), 0 0 0 8px var(--brass-edge), 0 24px 44px -8px rgb(0 0 0 / 0__45)",
		"xl": "0 0 0 1px var(--brass-edge), 0 0 0 9px var(--brass-face), 0 0 0 10px var(--brass-edge), 0 36px 64px -10px rgb(0 0 0 / 0__5)",
		"inner": "inset 0 0 0 1px var(--brass-edge)",
		"focus": "0 0 0 2px var(--color-bg), 0 0 0 5px var(--color-border-focus)"
	},
	"state": {
		"hover": {
			"decoration": "underline"
		},
		"selected": {
			"indicator": "inset 0 -2px 0 0 var(--brass-edge)"
		},
		"disabled": {
			"opacity": "0__6",
			"pattern": "repeating-linear-gradient(90deg, transparent 0 5px, var(--color-bg-emphasis) 5px 6px)"
		},
		"focus": {
			"width": "3px",
			"offset": "6px"
		},
		"invalid": {
			"border": {
				"style": "double",
				"width": "3px"
			}
		}
	},
	"btn": {
		"font": {
			"weight": {
				"$ref": "$weight.bold"
			}
		},
		"letter": {
			"spacing": {
				"$ref": "$tracking.widest"
			}
		},
		"padding": {
