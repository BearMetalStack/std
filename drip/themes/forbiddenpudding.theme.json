	"pudding": {
		"shine": "rgb(255 255 255 / 0__7)",
		"depth": {
			"$ref": "$color.brand.400"
		},
		"floor": {
			"$ref": "$color.neutral.900"
		}
	},
	"radius": {
		"base": "0__9rem"
	},
	"corner": {
		"shape": "superellipse(1__4)",
		"pill": "round"
	},
	"shadow": {
		"xs": "inset 0 3px 3px -2px var(--pudding-shine), inset 0 -6px 6px -3px var(--pudding-depth), 0 6px 6px -3px var(--pudding-floor)",
		"sm": "inset 0 5px 5px -3px var(--pudding-shine), inset 0 -10px 10px -5px var(--pudding-depth), 0 10px 10px -5px var(--pudding-floor)",
		"base": "inset 0 7px 7px -4px var(--pudding-shine), inset 0 -14px 14px -7px var(--pudding-depth), 0 14px 14px -7px var(--pudding-floor)",
		"md": "inset 0 9px 9px -5px var(--pudding-shine), inset 0 -18px 18px -9px var(--pudding-depth), 0 18px 18px -9px var(--pudding-floor)",
		"lg": "inset 0 12px 12px -6px var(--pudding-shine), inset 0 -24px 24px -12px var(--pudding-depth), 0 24px 24px -12px var(--pudding-floor)",
		"xl": "inset 0 16px 16px -8px var(--pudding-shine), inset 0 -32px 32px -16px var(--pudding-depth), 0 32px 32px -16px var(--pudding-floor)",
		"inner": "inset 0 4px 8px -2px var(--pudding-depth)",
		"focus": "0 0 0 3px var(--color-bg), 0 0 0 6px var(--color-border-focus)"
	},
	"state": {
		"selected": {
			"indicator": "inset 0 -4px 6px -2px var(--pudding-depth)"
		},
		"pressed": {
			"translate": "0 2px"
		},
		"disabled": {
			"opacity": "0__7",
			"pattern": "repeating-linear-gradient(-45deg, transparent 0 8px, var(--color-bg-emphasis) 8px 16px)",
			"border": {
				"style": "dashed"
			}
		},
		"focus": {
			"width": "3px",
			"style": "dashed",
			"offset": "4px"
		}
	},
	"alert": {
		"warning": {
			"border": {
				"style": "dashed"
			}
		},
		"danger": {
			"border": {
				"style": "dashed"
			}
		}
	},
	"btn": {
		"font": {
