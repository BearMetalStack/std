		"muck": {
			"$ref": "$color.neutral.800"
		}
	},
	"radius": {
		"base": "0__375rem"
	},
	"corner": {
		"shape": "superellipse(0__5)",
		"pill": "bevel"
	},
	"border": {
		"rule": {
			"$ref": "$border.2"
		}
	},
	"shadow": {
		"xs": "inset 0 0 6px 0 var(--goblin-grime), 2px 3px 0 0 var(--goblin-muck)",
		"sm": "inset 0 0 10px 0 var(--goblin-grime), 3px 4px 0 0 var(--goblin-muck)",
		"base": "inset 0 0 14px 0 var(--goblin-grime), 4px 6px 0 0 var(--goblin-muck)",
		"md": "inset 0 0 18px 0 var(--goblin-grime), 5px 8px 0 0 var(--goblin-muck)",
		"lg": "inset 0 0 24px 0 var(--goblin-grime), 7px 11px 0 0 var(--goblin-muck)",
		"xl": "inset 0 0 32px 0 var(--goblin-grime), 9px 14px 0 0 var(--goblin-muck)",
		"inner": "inset 0 0 8px 0 var(--goblin-grime)",
		"focus": "0 0 0 2px var(--color-bg), 0 0 0 5px var(--color-border-focus)"
	},
	"state": {
		"hover": {
			"decoration": "underline dashed"
		},
		"selected": {
			"indicator": "inset 4px 0 0 0 var(--color-accent)"
		},
		"pressed": {
			"translate": "2px 3px"
		},
		"disabled": {
			"opacity": "0__6",
			"pattern": "repeating-linear-gradient(45deg, transparent 0 5px, var(--color-bg-emphasis) 5px 6px), repeating-linear-gradient(-45deg, transparent 0 5px, var(--color-bg-emphasis) 5px 6px)",
			"border": {
				"style": "dashed"
			}
		},
		"focus": {
			"width": "4px",
			"style": "double",
			"offset": "3px"
		}
	},
	"btn": {
		"font": {
			"weight": {
				"$ref": "$weight.bold"
			}
		},
		"radius": {
			"xs": "0__5rem 0__1rem 0__35rem 0__15rem",
			"sm": "0__7rem 0__15rem 0__5rem 0__25rem",
			"base": "0__9rem 0__2rem 0__65rem 0__3rem",
			"lg": "1__3rem 0__3rem 0__9rem 0__45rem"
		},
		"padding": {
			"x": {
