{
	"name": "@bearmetal/drip",
	"version": "0.1.7",
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./tokens": "./css/tokens.ts",
		"./ssr": "./ssr.tsx",
		"./fonts": "./fonts/mod.ts",
		"./namespaces": "./namespaces.ts",
		"./palette": "./palette/mod.tsx",
		"./build": "./build.ts"
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@bearmetal/jsx"
	},
	"publish": {
		"exclude": [
			"fonts/assets",
			"fonts/tools",
			"fonts/generate.ts",
			"css/embed.ts"
		]
	},
	"tasks": {
		"dev": "deno test --watch",
		"bm:drip": {
			"description": "Generates theme completions and CSS",
			"command": "deno run -RW -E=BEARMETAL_ENV,BEARMETAL_DRIP_STRICT mod.ts"
		},
		"bm:css": {
			"description": "Re-embeds the compliant stylesheets from css/*.css",
			"command": "deno run -RW css/embed.ts"
		},
		"bm:fonts": {
			"description": "Re-embeds the self-hosted font sheets from fonts/assets",
			"command": "deno run -RW fonts/generate.ts"
		},
		"drip:palette": {
			"command": "deno run -A --watch palette/mod.tsx"
		}
	},
	"license": "MIT"
}
