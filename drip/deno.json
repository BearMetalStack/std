{
	"name": "@bearmetal/drip",
	"version": "0.0.4",
	"exports": {
		".": "./mod.ts",
		"./ssr": "./ssr.tsx",
		"./namespaces": "./namespaces.ts",
		"./palette": "./palette/mod.tsx"
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@bearmetal/jsx/server"
	},
	"tasks": {
		"dev": "deno test --watch",
		"bm:drip": {
			"description": "Generates theme completions and CSS",
			"command": "deno run -RW mod.ts"
		},
		"drip:palette": {
			"command": "deno run -A --watch palette/mod.tsx"
		}
	},
	"license": "GPL-3.0-only"
}
