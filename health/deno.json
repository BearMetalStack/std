{
	"name": "@bearmetal/health",
	"description": "Health checks, request metrics, and a dashboard manifest for BearMetal apps",
	"version": "0.1.0",
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./types": "./types.ts",
		"./schema": "./schema.ts",
		"./components": "./components/mod.ts",
		"./reduce": "./reduce.ts",
		"./paths": "./paths.ts",
		"./format": "./format.ts"
	},
	"tasks": {
		"dev": "deno test -P=test --watch",
		"test": "deno test -P=test",
		"bm:embed": {
			"description": "Re-bundles the dashboard components into client/embedded.ts",
			"command": "deno run -A client/embed.ts"
		}
	},
	"permissions": {
		"test": {
			"env": [
				"BEARMETAL_ENV",
				"BEARMETAL_HEALTH_TOKEN"
			],
			"read": true
		}
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "@bearmetal/jsx",
		"jsxImportSourceTypes": "@bearmetal/jsx"
	},
	"publish": {
		"exclude": [
			"client/embed.ts",
			"client/entry.ts"
		]
	}
}
